-- import '../../../shared/data/converters/color_converter.dart';

CREATE TABLE custom_terminal_themes (
    id                    TEXT NOT NULL PRIMARY KEY DEFAULT '',
    name                  TEXT NOT NULL,

    black                 INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    red                   INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    green                 INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    yellow                INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    blue                  INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    purple                INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    cyan                  INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    white                 INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_black          INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_red            INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_green          INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_yellow         INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_blue           INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_purple         INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_cyan           INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    bright_white          INTEGER NOT NULL MAPPED BY `const ColorConverter()`,

    background            INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    foreground            INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    cursor                INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    cursor_text           INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    selection_background  INTEGER NOT NULL MAPPED BY `const ColorConverter()`,
    selection_foreground  INTEGER NOT NULL MAPPED BY `const ColorConverter()`,

    UNIQUE (
      name,
      black, red, green, yellow, blue, purple, cyan, white,
      bright_black, bright_red, bright_green, bright_yellow, bright_blue, bright_purple, bright_cyan, bright_white,
      background, foreground,
      cursor, cursor_text,
      selection_background, selection_foreground
    )
);

createOrUpdateCustomColorScheme:
  INSERT INTO custom_terminal_themes (
    id,
    name,
    black,
    red,
    green,
    yellow,
    blue,
    purple,
    cyan,
    white,
    bright_black,
    bright_red,
    bright_green,
    bright_yellow,
    bright_blue,
    bright_purple,
    bright_cyan,
    bright_white,
    background,
    foreground,
    cursor,
    cursor_text,
    selection_background,
    selection_foreground
  ) VALUES (
    :id,
    :name,
    :blackColor,
    :redColor,
    :greenColor,
    :yellowColor,
    :blueColor,
    :purpleColor,
    :cyanColor,
    :whiteColor,
    :brightBlackColor,
    :brightRedColor,
    :brightGreenColor,
    :brightYellowColor,
    :brightBlueColor,
    :brightPurpleColor,
    :brightCyanColor,
    :brightWhiteColor,
    :backgroundColor,
    :foregroundColor,
    :cursorColor,
    :cursorTextColor,
    :selectionBackgroundColor,
    :selectionForegroundColor
  )
  ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    black = excluded.black,
    red = excluded.red,
    green = excluded.green,
    yellow = excluded.yellow,
    blue = excluded.blue,
    purple = excluded.purple,
    cyan = excluded.cyan,
    white = excluded.white,
    bright_black = excluded.bright_black,
    bright_red = excluded.bright_red,
    bright_green = excluded.bright_green,
    bright_yellow = excluded.bright_yellow,
    bright_blue = excluded.bright_blue,
    bright_purple = excluded.bright_purple,
    bright_cyan = excluded.bright_cyan,
    bright_white = excluded.bright_white,
    background = excluded.background,
    foreground = excluded.foreground,
    cursor = excluded.cursor,
    cursor_text = excluded.cursor_text,
    selection_background = excluded.selection_background,
    selection_foreground = excluded.selection_foreground;

findAllCustomColorSchemesByIds:
  SELECT * FROM custom_terminal_themes WHERE id IN ?;

findMatchingCustomColorSchemeId:
  SELECT id FROM custom_terminal_themes WHERE
    name = :name
    AND black = :black
    AND red = :red
    AND green = :green
    AND yellow = :yellow
    AND blue = :blue
    AND purple = :purple
    AND cyan = :cyan
    AND white = :white
    AND bright_black = :brightBlack
    AND bright_red = :brightRed
    AND bright_green = :brightGreen
    AND bright_yellow = :brightYellow
    AND bright_blue = :brightBlue
    AND bright_purple = :brightPurple
    AND bright_cyan = :brightCyan
    AND bright_white = :brightWhite
    AND background = :background
    AND foreground = :foreground
    AND cursor = :cursor
    AND cursor_text = :cursorText
    AND selection_background = :selectionBackground
    AND selection_foreground = :selectionForeground
  LIMIT 1;
